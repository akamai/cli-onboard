{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "long": {
      "format": "%(asctime)s %(process)d %(filename)-17s %(lineno)-5d %(levelname)-8s: %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "file_handler": {
      "class": "logging.FileHandler",
      "level": "DEBUG",
      "filename": "logs/onboard.log",
      "formatter": "long",
      "delay": true,
      "mode": "a",
      "encoding": "utf8"
    }
  },
  "root": {
    "handlers": [
      "file_handler"
    ]
  }
}
